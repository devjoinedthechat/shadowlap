{
  // The tests the Node pass (tsconfig.test.json) leaves out because they import the dashboard's
  // browser code: type-checked here against the DOM library, as the browser code itself is. The
  // workspace packages are read as their built declarations, as the browser code's own check reads
  // them, so the DOM's fetch typings never meet their sources: run it after `npm run build`, as
  // `npm run typecheck:tests` does in CI and before a commit.
  "extends": "./tsconfig.test.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "paths": {}
  },
  "include": [
    "packages/dashboard/test/normalize.test.ts",
    "packages/dashboard/test/ui-strip.test.ts",
    "packages/dashboard/test/ui-run-width.test.ts",
    "packages/dashboard/test/ui-run-scale.test.ts",
    "packages/dashboard/test/ui-check-words.test.ts",
    "packages/dashboard/test/ui-run-attempts.test.ts",
    "packages/dashboard/test/ui-next-step.test.ts",
    "packages/dashboard/test/ui-compare-states.test.ts",
    "packages/dashboard/test/ui-dialog-tab.test.ts",
    "packages/dashboard/test/ui-palette-ids.test.ts",
    "packages/dashboard/test/ui-client-cache.test.ts",
    "packages/dashboard/test/ui-tests-chaos.test.ts",
    "packages/dashboard/test/ui-runs-bulk.test.ts",
    "packages/dashboard/test/ui-overview-lists.test.ts",
    "packages/dashboard/test/ui-sidebar-runs.test.ts",
    "packages/dashboard/test/ui-fix-page.test.ts",
    "packages/dashboard/test/ui-tests-page.test.ts",
    "packages/dashboard/test/ui-training-page.test.ts",
    "packages/dashboard/test/ui-job-stop.test.ts",
    "packages/dashboard/test/ui-palette-modes.test.ts",
    "packages/dashboard/test/ui-token-card.test.ts",
    "packages/dashboard/test/ui-exported-provenance.test.ts",
    "packages/dashboard/test/ui-settings-states.test.ts",
    "packages/dashboard/test/ui-ci-tab.test.ts",
    "packages/dashboard/test/ui-about.test.ts",
    "packages/dashboard/test/ui-naming.test.ts",
    "packages/dashboard/test/ui-verdict.test.ts",
    "packages/dashboard/test/ui-presets.test.ts",
    "packages/dashboard/test/ui-run-header.test.ts",
    "packages/dashboard/test/run-roles.test.ts",
    "packages/dashboard/test/ui-focus.test.ts",
    "packages/dashboard/test/ui-fork-differences.test.ts",
    "packages/dashboard/test/ui-edit-and-fork.test.ts",
    "packages/dashboard/test/ui-fix-evidence.test.ts",
    "packages/dashboard/test/ui-render-counts.test.ts"
  ],
  "exclude": []
}
