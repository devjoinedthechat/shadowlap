{
  "name": "@shadowlap/dashboard",
  "version": "0.1.0",
  "description": "Shadowlap dashboard: a local web UI over your recordings (runs, timelines, conversations, diffs, replay and fork actions).",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.d.ts.map",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test:browser": "tsc -p browser/tsconfig.json && playwright test -c browser/playwright.config.ts"
  },
  "engines": {
    "node": "^22.16.0 || >=24"
  },
  "dependencies": {
    "@shadowlap/engine": "0.1.0",
    "@shadowlap/tui": "0.1.0",
    "@shadowlap/remote": "0.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "4.13.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devjoinedthechat/shadowlap.git",
    "directory": "packages/dashboard"
  },
  "homepage": "https://github.com/devjoinedthechat/shadowlap#readme",
  "bugs": {
    "url": "https://github.com/devjoinedthechat/shadowlap/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "ai-agents",
    "llm",
    "record-replay",
    "debugging",
    "dashboard"
  ]
}
