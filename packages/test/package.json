{
  "name": "@shadowlap/test",
  "version": "0.1.0",
  "description": "shadowlap for test suites: a test records its agent's model and tool calls on its first run and replays them offline after that. Vitest, Jest and node:test.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/cjs/recording.d.cts",
        "default": "./dist/cjs/recording.cjs"
      },
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./global-setup": {
      "types": "./dist/global-setup.d.ts",
      "default": "./dist/global-setup.js"
    },
    "./setup": {
      "types": "./dist/setup.d.ts",
      "default": "./dist/setup.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "default": "./dist/register.js"
    },
    "./jest/global-setup": {
      "types": "./dist/jest/global-setup.d.ts",
      "default": "./dist/jest/global-setup.js"
    },
    "./jest/global-teardown": {
      "types": "./dist/jest/global-teardown.d.ts",
      "default": "./dist/jest/global-teardown.js"
    },
    "./jest/environment": {
      "types": "./dist/jest/environment.d.ts",
      "default": "./dist/jest/environment.js"
    }
  },
  "typesVersions": {
    "*": {
      "global-setup": [
        "./dist/global-setup.d.ts"
      ],
      "setup": [
        "./dist/setup.d.ts"
      ],
      "register": [
        "./dist/register.d.ts"
      ],
      "jest/global-setup": [
        "./dist/jest/global-setup.d.ts"
      ],
      "jest/global-teardown": [
        "./dist/jest/global-teardown.d.ts"
      ],
      "jest/environment": [
        "./dist/jest/environment.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.17.0 || >=24"
  },
  "dependencies": {
    "shadowlap": "0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devjoinedthechat/shadowlap.git",
    "directory": "packages/test"
  },
  "homepage": "https://github.com/devjoinedthechat/shadowlap#readme",
  "bugs": {
    "url": "https://github.com/devjoinedthechat/shadowlap/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "ai-agents",
    "llm",
    "record-replay",
    "testing",
    "vitest",
    "vcr",
    "jest"
  ]
}
