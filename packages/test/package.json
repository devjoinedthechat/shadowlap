{
  "name": "@shadowlap/test",
  "version": "0.1.0",
  "description": "Shadowlap for test suites: a test records its agent's model and tool calls on its first run and replays them offline after that. Vitest and node:test.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./global-setup": {
      "types": "./dist/global-setup.d.ts",
      "default": "./dist/global-setup.js"
    },
    "./setup": {
      "types": "./dist/setup.d.ts",
      "default": "./dist/setup.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "default": "./dist/register.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "shadowlap": "^0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devjoinedthechat/shadowlap.git",
    "directory": "packages/test"
  },
  "homepage": "https://github.com/devjoinedthechat/shadowlap#readme",
  "bugs": {
    "url": "https://github.com/devjoinedthechat/shadowlap/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "ai-agents",
    "llm",
    "record-replay",
    "testing",
    "vitest",
    "vcr"
  ]
}
