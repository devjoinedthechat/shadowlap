{
  "name": "@shadowlap/collector",
  "version": "0.1.0",
  "description": "The self-hostable telemetry collector for shadowlap: a strict allowlist, SQLite, aggregate stats and a dashboard.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "shadowlap-collector": "./bin/shadowlap-collector.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "!dist/**/*.d.ts.map",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.17.0 || >=24"
  },
  "dependencies": {
    "@shadowlap/engine": "0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devjoinedthechat/shadowlap.git",
    "directory": "packages/collector"
  },
  "homepage": "https://github.com/devjoinedthechat/shadowlap#readme",
  "bugs": {
    "url": "https://github.com/devjoinedthechat/shadowlap/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "telemetry",
    "collector",
    "self-hosted",
    "sqlite",
    "privacy"
  ]
}
