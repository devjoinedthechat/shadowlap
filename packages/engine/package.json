{
  "name": "@shadowlap/engine",
  "version": "0.1.0",
  "description": "shadowlap engine: fingerprinting, normalizers, matching, divergence diff, SQLite store.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./classify": {
      "types": "./dist/classify.d.ts",
      "default": "./dist/classify.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite.d.ts",
      "default": "./dist/sqlite.js"
    },
    "./body": {
      "types": "./dist/body.d.ts",
      "default": "./dist/body.js"
    }
  },
  "typesVersions": {
    "*": {
      "classify": [
        "./dist/classify.d.ts"
      ],
      "sqlite": [
        "./dist/sqlite.d.ts"
      ],
      "body": [
        "./dist/body.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "!dist/**/*.d.ts.map",
    "data",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.16.0 || >=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devjoinedthechat/shadowlap.git",
    "directory": "packages/engine"
  },
  "homepage": "https://github.com/devjoinedthechat/shadowlap#readme",
  "bugs": {
    "url": "https://github.com/devjoinedthechat/shadowlap/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "ai-agents",
    "llm",
    "record-replay",
    "debugging",
    "anthropic",
    "openai",
    "deterministic-replay"
  ]
}
