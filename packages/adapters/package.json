{
  "name": "@shadowlap/adapters",
  "version": "0.1.0",
  "description": "Framework adapters for Shadowlap: declare tool effects once for the Vercel AI SDK, OpenAI Agents SDK, Mastra, LangChain/LangGraph and the Anthropic tool runner.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ai-sdk": {
      "types": "./dist/ai-sdk.d.ts",
      "default": "./dist/ai-sdk.js"
    },
    "./openai-agents": {
      "types": "./dist/openai-agents.d.ts",
      "default": "./dist/openai-agents.js"
    },
    "./mastra": {
      "types": "./dist/mastra.d.ts",
      "default": "./dist/mastra.js"
    },
    "./anthropic": {
      "types": "./dist/anthropic.d.ts",
      "default": "./dist/anthropic.js"
    },
    "./langchain": {
      "types": "./dist/langchain.d.ts",
      "default": "./dist/langchain.js"
    }
  },
  "typesVersions": {
    "*": {
      "ai-sdk": [
        "./dist/ai-sdk.d.ts"
      ],
      "openai-agents": [
        "./dist/openai-agents.d.ts"
      ],
      "mastra": [
        "./dist/mastra.d.ts"
      ],
      "anthropic": [
        "./dist/anthropic.d.ts"
      ],
      "langchain": [
        "./dist/langchain.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "dependencies": {
    "@shadowlap/sdk": "0.1.0"
  },
  "devDependencies": {
    "@shadowlap/engine": "0.1.0",
    "@shadowlap/sidecar": "0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devjoinedthechat/shadowlap.git",
    "directory": "packages/adapters"
  },
  "homepage": "https://github.com/devjoinedthechat/shadowlap#readme",
  "bugs": {
    "url": "https://github.com/devjoinedthechat/shadowlap/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "ai-agents",
    "llm",
    "record-replay",
    "deterministic-replay",
    "vercel-ai-sdk",
    "openai-agents",
    "mastra",
    "langchain",
    "langgraph",
    "anthropic"
  ]
}
