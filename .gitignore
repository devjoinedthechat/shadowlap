# shadowlap recordings (prompts, tool I/O) never belong in git; share via `shadowlap pack`
.shadowlap/

# Node
node_modules/
dist/
*.tsbuildinfo
.pnpm-store/

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/
sdks/python/build/

# Env and secrets
.env
.env.*
!.env.example

