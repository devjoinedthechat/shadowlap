# What CI installs into Python, pinned in python-constraints.txt, which every pip install in the CI
# workflow reads (PIP_CONSTRAINT). Change this list, then compile it again from the root with the
# command at the top of python-constraints.txt: one resolution for every Python the jobs run (3.9 to
# 3.14, and 3.14t) and every system, forked by version where a package's newest release drops one.

# The clients the suite's Python agents build (testing/default-clients), and the async clients the
# guard and in-process capture are tested with. uvloop runs on macOS and Linux only.
anthropic
openai
google-genai
boto3
aiohttp
websockets
aiobotocore
uvloop; sys_platform != "win32"

# The SDK's tests: on 3.9 and 3.10 the oldest pytest and pluggy its plugin loads on, which the
# python-sdk job's matrix names too; the newest after that.
pytest==6.2.5; python_version < "3.10"
pluggy==0.13.1; python_version < "3.10"
pytest==7.4.4; python_version == "3.10"
pluggy==1.1.0; python_version == "3.10"
pytest; python_version >= "3.11"
trio
anyio

# The SDK's types (the python-sdk-types job), and what builds the SDK when it is installed
# (sdks/python/pyproject.toml's build-system).
mypy==2.4.0; python_version >= "3.10"
setuptools>=77
