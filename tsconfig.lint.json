{
  // The repository's JavaScript as ESLint reads it (eslint.config.mjs): the scripts, the guard's
  // preloads, the Action, test agents and harnesses. Nothing here is type-checked (checkJs is off):
  // the program only gives ESLint's type-aware rules the types TypeScript infers for it. The
  // .d.mts files beside some of these modules are left out, so the modules themselves are read;
  // the tests' own pass (tsconfig.test.json) reads those declarations.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "inlineSources": false
  },
  "include": ["**/*.js", "**/*.mjs", "**/*.cjs", "vitest.config.ts"],
  "exclude": ["**/dist", "**/node_modules", "**/.venv", "testing/frameworks/.tmp-*", "scripts/out", "sdks/python/build"]
}
