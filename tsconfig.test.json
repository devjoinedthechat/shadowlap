{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "inlineSources": false,
    // Tests index fixtures they built themselves; a wrong index fails the assertion anyway, and
    // writing `x![0]` everywhere would add noise without safety. Every other strict check applies.
    "noUncheckedIndexedAccess": false,
    "paths": {
      "@shadowlap/engine": ["./packages/engine/src/index.ts"],
      "@shadowlap/engine/classify": ["./packages/engine/src/classify.ts"],
      "@shadowlap/sidecar": ["./packages/sidecar/src/index.ts"],
      "@shadowlap/sdk": ["./packages/sdk/src/index.ts"],
      "@shadowlap/adapters": ["./packages/adapters/src/index.ts"],
      "@shadowlap/adapters/*": ["./packages/adapters/src/*"],
      "@shadowlap/tui": ["./packages/tui/src/index.ts"],
      "@shadowlap/tui/*": ["./packages/tui/src/*"],
      "@shadowlap/dashboard": ["./packages/dashboard/src/index.ts"],
      "@shadowlap/collector": ["./packages/collector/src/index.ts"],
      "@shadowlap/remote": ["./packages/remote/src/index.ts"],
      "@shadowlap-testing/mock-anthropic": ["./testing/mock-anthropic/src/index.ts"],
      "@shadowlap-testing/mock-openai": ["./testing/mock-openai/src/index.ts"],
      "@shadowlap-testing/mock-gemini": ["./testing/mock-gemini/src/index.ts"]
    }
  },
  "include": ["packages/*/test/**/*.ts", "packages/*/test/**/*.tsx", "testing/**/test/**/*.ts"],
  "exclude": [
    // These import the dashboard's browser modules, which need the DOM library. Adding it here
    // would shadow Node's fetch typings for every source file in the same pass, so they have a
    // pass of their own, tsconfig.test-dom.json, as the browser code has: build-ui.mjs runs tsc
    // over ui/tsconfig.json before bundling. A test added here is added there.
    "packages/dashboard/test/normalize.test.ts",
    // These render the run page's components, which use the DOM too.
    "packages/dashboard/test/ui-strip.test.ts",
    "packages/dashboard/test/ui-run-width.test.ts",
    "packages/dashboard/test/ui-run-scale.test.ts",
    "packages/dashboard/test/ui-check-words.test.ts",
    "packages/dashboard/test/ui-run-attempts.test.ts",
    "packages/dashboard/test/ui-next-step.test.ts",
    "packages/dashboard/test/ui-compare-states.test.ts",
    // These render the shell's dialogs and palette, or ask through the page's client.
    "packages/dashboard/test/ui-dialog-tab.test.ts",
    "packages/dashboard/test/ui-palette-ids.test.ts",
    "packages/dashboard/test/ui-client-cache.test.ts",
    // These render the Runs page's bulk bar, the Overview's panels and the lists of runs.
    "packages/dashboard/test/ui-runs-bulk.test.ts",
    "packages/dashboard/test/ui-overview-lists.test.ts",
    "packages/dashboard/test/ui-sidebar-runs.test.ts",
    // This renders a fix's page.
    "packages/dashboard/test/ui-fix-page.test.ts",
    // These render the Tests and Training pages.
    "packages/dashboard/test/ui-tests-chaos.test.ts",
    "packages/dashboard/test/ui-tests-page.test.ts",
    "packages/dashboard/test/ui-training-page.test.ts",
    // These render the job drawer and the top bar, the palette, the card a refused link shows and
    // an exported copy's Provenance.
    "packages/dashboard/test/ui-job-stop.test.ts",
    "packages/dashboard/test/ui-palette-modes.test.ts",
    "packages/dashboard/test/ui-token-card.test.ts",
    "packages/dashboard/test/ui-exported-provenance.test.ts",
    // These render Settings.
    "packages/dashboard/test/ui-settings-states.test.ts",
    "packages/dashboard/test/ui-ci-tab.test.ts",
    // This fits run names' about lines, which measures the page.
    "packages/dashboard/test/ui-about.test.ts",
    // This renders the places that name a run.
    "packages/dashboard/test/ui-naming.test.ts",
    // These render the places that say a gate's verdict, and a preset's attempt and presets.
    "packages/dashboard/test/ui-verdict.test.ts",
    "packages/dashboard/test/ui-presets.test.ts",
    // These render the run header and read which runs are attempts through the run page's modules.
    "packages/dashboard/test/ui-run-header.test.ts",
    "packages/dashboard/test/run-roles.test.ts",
    // This renders the skip link, the palette, a menu, a dialog and the card a refused link shows.
    "packages/dashboard/test/ui-focus.test.ts",
    // These render what a fork did differently, and Edit and fork.
    "packages/dashboard/test/ui-fork-differences.test.ts",
    "packages/dashboard/test/ui-edit-and-fork.test.ts",
    // This renders a fix's steps with what their verdicts say beyond their tallies.
    "packages/dashboard/test/ui-fix-evidence.test.ts",
    // This counts what the shared state redraws as the shell polls.
    "packages/dashboard/test/ui-render-counts.test.ts",
    // These render the Runs page, a page of its table at a time, and a run's page, a page of its calls at a time.
    "packages/dashboard/test/ui-runs-paging.test.ts",
    "packages/dashboard/test/ui-run-paging.test.ts"
  ]
}
